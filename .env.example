# Starknet MAINNET RPC — used only by code that touches the real STRK20 pool
# (see src/lib/contracts/mainnetRpc.ts). Create a free key at
# https://www.alchemy.com, then copy this file to `.env.local` and fill in:
VITE_STARKNET_MAINNET_RPC_URL=https://starknet-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE

# `.env.local` is gitignored — never commit a real key.

# --- AI agents (server-side only) -------------------------------------------
# Deliberately NOT prefixed with VITE_: Vite only exposes VITE_-prefixed vars
# to the browser bundle, so this key is only ever read inside api/_lib/openaiClient.ts,
# which runs as a Vercel Edge Function in production and through the local
# dev-server bridge (vite.apiBridge.ts) in development. It is never sent to,
# or reachable from, client-side code. Without it, the app falls back to
# MockAIProvider automatically — no key is required to run or test the app.
OPENAI_API_KEY=
# Optional — defaults to gpt-6-astra if unset.
AI_MODEL=gpt-6-astra

